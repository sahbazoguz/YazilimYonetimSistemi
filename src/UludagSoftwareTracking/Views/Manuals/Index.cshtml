@model ManualOverviewViewModel
@using UludagSoftwareTracking.Models.Entities
@{
    ViewData["Title"] = "Kılavuz Yönetimi";
}

<section class="form-alani">
    <h1>Sorumlu Olduğum Yazılımlar</h1>
    <a class="buton-link" asp-action="Yukle">Detaylı Yükleme Ekranı</a>
</section>

@if (Model.Yazilimlar.Count == 0)
{
    <p>Yetkilendirildiğiniz bir yazılım bulunamadı.</p>
}
else
{
    <div class="kilavuz-kartlar">
        @foreach (var yazilim in Model.Yazilimlar)
        {
            <article class="kart kilavuz-karti">
                <header class="kart-baslik">
                    <h2>@yazilim.Ad</h2>
                    @if (!string.IsNullOrWhiteSpace(yazilim.BirimAdi))
                    {
                        <span class="etiket">@yazilim.BirimAdi</span>
                    }
                </header>
                @if (!string.IsNullOrWhiteSpace(yazilim.Aciklama))
                {
                    <p class="yardim-metin">@yazilim.Aciklama</p>
                }

                <div class="kilavuz-bilgisi">
                    <h3>Mevcut Kılavuzlar</h3>
                    <ul class="kilavuz-listesi">
                        <li>
                            <span class="kilavuz-etiket">Teknik Kılavuz:</span>
                            @if (yazilim.TeknikKilavuz is not null)
                            {
                                <div class="kilavuz-detay">
                                    <a href="@yazilim.TeknikKilavuz.DosyaYolu" target="_blank" rel="noopener">@yazilim.TeknikKilavuz.Baslik</a>
                                    @if (!string.IsNullOrWhiteSpace(yazilim.TeknikKilavuz.Versiyon))
                                    {
                                        <span class="etiket">@($"v{yazilim.TeknikKilavuz.Versiyon}")</span>
                                    }
                                    <small class="yardim-metin">@yazilim.TeknikKilavuz.YuklenmeZamani.ToLocalTime().ToString("dd.MM.yyyy HH:mm") - @yazilim.TeknikKilavuz.Yukleyen</small>
                                    @if (!string.IsNullOrWhiteSpace(yazilim.TeknikKilavuz.DegisimNotu))
                                    {
                                        <span class="yardim-metin">@yazilim.TeknikKilavuz.DegisimNotu</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span>Henüz yüklenmedi</span>
                            }
                        </li>
                        <li>
                            <span class="kilavuz-etiket">Kullanım Kılavuzu:</span>
                            @if (yazilim.KullanimKilavuzu is not null)
                            {
                                <div class="kilavuz-detay">
                                    <a href="@yazilim.KullanimKilavuzu.DosyaYolu" target="_blank" rel="noopener">@yazilim.KullanimKilavuzu.Baslik</a>
                                    @if (!string.IsNullOrWhiteSpace(yazilim.KullanimKilavuzu.Versiyon))
                                    {
                                        <span class="etiket">@($"v{yazilim.KullanimKilavuzu.Versiyon}")</span>
                                    }
                                    <small class="yardim-metin">@yazilim.KullanimKilavuzu.YuklenmeZamani.ToLocalTime().ToString("dd.MM.yyyy HH:mm") - @yazilim.KullanimKilavuzu.Yukleyen</small>
                                    @if (!string.IsNullOrWhiteSpace(yazilim.KullanimKilavuzu.DegisimNotu))
                                    {
                                        <span class="yardim-metin">@yazilim.KullanimKilavuzu.DegisimNotu</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span>Henüz yüklenmedi</span>
                            }
                        </li>
                    </ul>
                </div>

                @if (yazilim.TeknikKilavuzYetkisi)
                {
                    <section class="kilavuz-formu">
                        <h3>Teknik Kılavuz Yükle/Güncelle</h3>
                        <form asp-action="Yukle" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SoftwareId" value="@yazilim.Id" />
                            <input type="hidden" name="ManualType" value="@((int)ManualType.TeknikKilavuz)" />
                            <input type="hidden" name="returnToIndex" value="true" />
                            <div>
                                <label for="teknik-baslik-@yazilim.Id">Başlık</label>
                                <input id="teknik-baslik-@yazilim.Id" name="Title" value="@(!string.IsNullOrWhiteSpace(yazilim.TeknikKilavuz?.Baslik) ? yazilim.TeknikKilavuz!.Baslik : $"{yazilim.Ad} Teknik Kılavuzu")" required />
                            </div>
                            <div>
                                <label for="teknik-dosya-@yazilim.Id">Dosya Yolu</label>
                                <input id="teknik-dosya-@yazilim.Id" name="FilePath" value="@yazilim.TeknikKilavuz?.DosyaYolu" />
                            </div>
                            <div class="cift-kolon">
                                <div>
                                    <label for="teknik-versiyon-@yazilim.Id">Versiyon</label>
                                    <input id="teknik-versiyon-@yazilim.Id" name="Version" value="@yazilim.TeknikKilavuz?.Versiyon" />
                                </div>
                                <div>
                                    <label for="teknik-not-@yazilim.Id">Değişiklik Notu</label>
                                    <textarea id="teknik-not-@yazilim.Id" name="ChangeLog" rows="2">@(yazilim.TeknikKilavuz?.DegisimNotu)</textarea>
                                </div>
                            </div>
                            <button type="submit">Teknik Kılavuzu Kaydet</button>
                        </form>
                    </section>
                }

                @if (yazilim.KullanimKilavuzuYetkisi)
                {
                    <section class="kilavuz-formu">
                        <h3>Kullanım Kılavuzu Yükle/Güncelle</h3>
                        <form asp-action="Yukle" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SoftwareId" value="@yazilim.Id" />
                            <input type="hidden" name="ManualType" value="@((int)ManualType.KullanimKilavuzu)" />
                            <input type="hidden" name="returnToIndex" value="true" />
                            <div>
                                <label for="kullanim-baslik-@yazilim.Id">Başlık</label>
                                <input id="kullanim-baslik-@yazilim.Id" name="Title" value="@(!string.IsNullOrWhiteSpace(yazilim.KullanimKilavuzu?.Baslik) ? yazilim.KullanimKilavuzu!.Baslik : $"{yazilim.Ad} Kullanım Kılavuzu")" required />
                            </div>
                            <div>
                                <label for="kullanim-dosya-@yazilim.Id">Dosya Yolu</label>
                                <input id="kullanim-dosya-@yazilim.Id" name="FilePath" value="@yazilim.KullanimKilavuzu?.DosyaYolu" />
                            </div>
                            <div class="cift-kolon">
                                <div>
                                    <label for="kullanim-versiyon-@yazilim.Id">Versiyon</label>
                                    <input id="kullanim-versiyon-@yazilim.Id" name="Version" value="@yazilim.KullanimKilavuzu?.Versiyon" />
                                </div>
                                <div>
                                    <label for="kullanim-not-@yazilim.Id">Değişiklik Notu</label>
                                    <textarea id="kullanim-not-@yazilim.Id" name="ChangeLog" rows="2">@(yazilim.KullanimKilavuzu?.DegisimNotu)</textarea>
                                </div>
                            </div>
                            <button type="submit">Kullanım Kılavuzunu Kaydet</button>
                        </form>
                    </section>
                }
            </article>
        }
    </div>
}
