@model RequestDetailViewModel
@{
    ViewData["Title"] = Model.Talep?.Title ?? "Talep Detayı";
}

@functions {
    public static string StageName(AssessmentStage stage) => stage switch
    {
        AssessmentStage.DegerlendiriciBir => "Değerlendirici 1",
        AssessmentStage.DegerlendiriciIki => "Değerlendirici 2",
        AssessmentStage.DegerlendiriciUc => "Değerlendirici 3",
        AssessmentStage.BaskanOnayi => "Değerlendirme Başkanı",
        _ => "Değerlendirme"
    };
}

<section class="form-alani">
    <h1>@Model.Talep?.Title</h1>
    <p>@Model.Talep?.Description</p>
    <p><strong>Birim:</strong> @Model.Talep?.Department?.Name</p>
    <p><strong>Talep Sahibi:</strong> @Model.Talep?.RequestedByUser?.FullName</p>
    <p><strong>Durum:</strong> @Model.Talep?.Status</p>
    <p><strong>Öncelik:</strong> @Model.Talep?.Priority</p>
    <p><strong>Oluşturulma:</strong> @Model.Talep?.CreatedAt.ToString("dd.MM.yyyy")</p>
    @if (Model.Talep?.DesiredCompletionDate is not null)
    {
        <p><strong>Hedef Tarih:</strong> @Model.Talep.DesiredCompletionDate?.ToString("dd.MM.yyyy")</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Talep?.RejectionReason))
    {
        <p><strong>Red Nedeni:</strong> @Model.Talep?.RejectionReason</p>
    }
</section>

@if (Model.Onaylar.Any())
{
    <section>
        <h2>Onay Geçmişi</h2>
        <table class="tablo">
            <thead>
                <tr>
                    <th>Durum</th>
                    <th>Yetkili</th>
                    <th>Tarih</th>
                    <th>Not</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var onay in Model.Onaylar)
            {
                <tr>
                    <td>@onay.Status</td>
                    <td>@onay.ApprovedByUser?.FullName</td>
                    <td>@onay.DecidedAt?.ToString("dd.MM.yyyy")</td>
                    <td>@onay.Notes</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}

@{
    var kullaniciBirim = User.IsInRole(RoleConstants.Roles.BirimKullanicisi) || User.IsInRole(RoleConstants.Roles.BirimYetkilisi);
}

@if (Model.Degerlendirmeler.Any() && !kullaniciBirim)
{
    <section>
        <h2>Teknik Değerlendirme</h2>
        <table class="tablo">
            <thead>
                <tr>
                    <th>Aşama</th>
                    <th>Sonuç</th>
                    <th>Uzman</th>
                    <th>Tarih</th>
                    <th>Açıklama</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var degerlendirme in Model.Degerlendirmeler)
            {
                <tr>
                    <td>@StageName(degerlendirme.Stage)</td>
                    <td>@degerlendirme.Result</td>
                    <td>@degerlendirme.AssessedByUser?.FullName</td>
                    <td>@degerlendirme.AssessedOn?.ToString("dd.MM.yyyy")</td>
                    <td>@degerlendirme.Notes</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
else if (kullaniciBirim && Model.Talep is not null)
{
    var durum = Model.Talep.Status;
    <section>
        <h2>Talep Durumu</h2>
        <ul class="durum-zinciri">
            <li class="aktif">Başvuru Alındı</li>
            <li class="@(durum >= RequestStatus.OnayBekleniyor ? "aktif" : string.Empty)">Birim Onayı Bekleniyor</li>
            <li class="@(durum >= RequestStatus.Degerlendirmede ? "aktif" : string.Empty)">Değerlendirmede</li>
            <li class="@(durum == RequestStatus.Gelistirmede || durum == RequestStatus.Tamamlandi || durum == RequestStatus.Kapandi ? "aktif" : string.Empty)">Onaylandı</li>
            @if (durum == RequestStatus.Reddedildi)
            {
                <li class="aktif reddedildi">Reddedildi</li>
            }
        </ul>
        @if (durum == RequestStatus.BaskanOnayiBekliyor)
        {
            <p class="yardim-metin">Teknik değerlendirme tamamlandı, başkan onayı bekleniyor.</p>
        }
        @if (durum == RequestStatus.Reddedildi && !string.IsNullOrWhiteSpace(Model.Talep.RejectionReason))
        {
            <p class="bilgi-kutu uyari">Red Gerekçesi: @Model.Talep.RejectionReason</p>
        }
    </section>
}

@if (Model.Proje is not null)
{
    <section class="form-alani">
        <h2>İlgili Proje</h2>
        <p><strong>Proje Adı:</strong> @Model.Proje.Name</p>
        <p><strong>Durum:</strong> @Model.Proje.Status</p>
        <p><strong>Sorumlu:</strong> @(Model.Proje.LeadUser?.FullName ?? "-")</p>
        @if ((ViewData["TakimAtamaIzni"] as bool? ?? false))
        {
            <p>
                <a class="buton-link" asp-action="Gorevlendir" asp-route-id="@Model.Talep!.Id">Ekip Görevlendir</a>
            </p>
        }
        <div class="algoritma-blok">
            <h3>Algoritma Akışı</h3>
            <div class="akisma-onizleme" id="algoritma-onizleme-@Model.Talep!.Id" data-flow-preview data-flow-source="@Model.AlgorithmJson">
                <p class="yardim-metin">Henüz adım eklenmedi.</p>
            </div>
            <div class="akisma-diagram-wrapper">
                <h4>Otomatik Akış Diyagramı</h4>
                <p class="yardim-metin">Girilen adımlardan Mermaid tabanlı akış diyagramları üretilir; tanımladığınız her akış ayrı bir şema olarak gösterilir.</p>
                <div class="akisma-diagram" id="algoritma-diagram-@Model.Talep!.Id" data-flow-diagram data-flow-source="@Model.AlgorithmJson"></div>
            </div>
        </div>
        <div class="kilavuz-blok">
            <h3>Kılavuzlar</h3>
            <ul class="kilavuz-listesi">
                <li>
                    <span class="kilavuz-etiket">Teknik Kılavuz:</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Proje.TechnicalGuidePath))
                    {
                        <a href="@Model.Proje.TechnicalGuidePath" target="_blank" rel="noopener">PDF'i görüntüle</a>
                    }
                    else
                    {
                        <span>Henüz yüklenmedi</span>
                    }
                </li>
                <li>
                    <span class="kilavuz-etiket">Kullanım Kılavuzu:</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Proje.UserGuidePath))
                    {
                        <a href="@Model.Proje.UserGuidePath" target="_blank" rel="noopener">PDF'i görüntüle</a>
                    }
                    else
                    {
                        <span>Henüz yüklenmedi</span>
                    }
                </li>
            </ul>
        </div>
        @if (Model.Proje.CompletedOn is not null)
        {
            <p><strong>Geliştirme Tamamlanma Tarihi:</strong> @Model.Proje.CompletedOn?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        }
        @if (Model.Proje.TestConfirmedOn is not null)
        {
            <p><strong>Birim Test Onayı:</strong> @Model.Proje.TestConfirmedOn?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        }
    </section>
}

@if (Model.Proje is not null && (User.IsInRole(RoleConstants.Roles.Yazilimci) || User.IsInRole(RoleConstants.Roles.BirimKullanicisi)))
{
    var algoritmaKilitli = ViewData["AlgoritmaButonPasif"] as bool? ?? false;
    var algorithmExampleJson = @"{
  ""flows"": [
    { ""label"": ""Yeni Talep Akışı"", ""startCode"": ""A1"" },
    { ""label"": ""Bakım Süreci"", ""startCode"": ""B1"" }
  ],
  ""steps"": [
    {
      ""code"": ""A1"",
      ""type"": ""Normal"",
      ""title"": ""Talep Oluşturma"",
      ""description"": ""Birim kullanıcısı yeni talep formunu doldurur."",
      ""role"": ""Birim Kullanıcısı"",
      ""next"": ""A2""
    },
    {
      ""code"": ""A2"",
      ""type"": ""Decision"",
      ""title"": ""Birim Yetkilisi Onayı"",
      ""description"": ""Yetkili talebi onaylıyor mu?"",
      ""role"": ""Birim Yetkilisi"",
      ""next"": {
        ""Evet"": ""A3"",
        ""Hayır"": ""A7""
      }
    },
    {
      ""code"": ""A3"",
      ""type"": ""Normal"",
      ""title"": ""Teknik Değerlendirme"",
      ""description"": ""Değerlendirme ekibi rapor hazırlar."",
      ""role"": ""Değerlendirme Ekibi"",
      ""next"": [""A4"", ""B2""]
    },
    {
      ""code"": ""A4"",
      ""type"": ""Normal"",
      ""title"": ""Başkan Kararı"",
      ""description"": ""Başkan nihai kararı verir."",
      ""role"": ""Değerlendirme Başkanı"",
      ""next"": ""A5""
    },
    {
      ""code"": ""A5"",
      ""type"": ""Normal"",
      ""title"": ""Geliştirme"",
      ""description"": ""Onaylanan talep yazılım ekibine aktarılır."",
      ""role"": ""Yazılımcı"",
      ""next"": ""A6""
    },
    {
      ""code"": ""A6"",
      ""type"": ""Normal"",
      ""title"": ""Kullanım Kılavuzu"",
      ""description"": ""Birim kullanıcıları kılavuz yükler."",
      ""role"": ""Birim Kullanıcısı"",
      ""next"": null
    },
    {
      ""code"": ""A7"",
      ""type"": ""Normal"",
      ""title"": ""Talep Kapanışı"",
      ""description"": ""Reddedilen talep kapatılır."",
      ""role"": ""Birim Yetkilisi"",
      ""next"": null
    },
    {
      ""code"": ""B1"",
      ""type"": ""Normal"",
      ""title"": ""Bakım Talebi"",
      ""description"": ""Mevcut yazılım için bakım isteği alınır."",
      ""role"": ""Birim Kullanıcısı"",
      ""next"": ""B2""
    },
    {
      ""code"": ""B2"",
      ""type"": ""Normal"",
      ""title"": ""Teknik İnceleme"",
      ""description"": ""Bakım planı değerlendirilir."",
      ""role"": ""Değerlendirme Ekibi"",
      ""next"": ""B3""
    },
    {
      ""code"": ""B3"",
      ""type"": ""Normal"",
      ""title"": ""Bakım Tamamlama"",
      ""description"": ""Yazılım ekibi bakım çalışmasını tamamlar."",
      ""role"": ""Yazılımcı"",
      ""next"": ""A6""
    }
  ]
}";

    <section class="form-alani">
        <h2>Algoritma Tasarım Editörü</h2>
        <form asp-action="AlgoritmaGuncelle" asp-route-id="@Model.Talep!.Id" method="post" data-flow-form data-flow-target="#algoritma-onizleme-@Model.Talep!.Id" data-flow-diagram-target="#algoritma-diagram-@Model.Talep!.Id">
            <input type="hidden" name="algoritmaJson" value="@Model.AlgorithmJson" data-flow-input />
            <div class="akisma-editor" data-flow-editor>
                <ul class="akisma-adim-listesi" data-flow-list></ul>
                <div class="akisma-baslangic-panel" data-flow-starts>
                    <header>
                        <h3>Başlangıç Akışları</h3>
                        <button type="button" class="buton-link" data-flow-start-add>Yeni Akış</button>
                    </header>
                    <ul class="akisma-baslangic-listesi" data-flow-start-list></ul>
                    <p class="yardim-metin">Her akış için bir başlangıç adımı seçin. Aynı adım birden fazla akışta kullanılabilir.</p>
                </div>
                <button type="button" class="buton-link" data-flow-add @(algoritmaKilitli ? "disabled=\"disabled\"" : string.Empty)>Yeni Adım Ekle</button>
            </div>
            <p class="yardim-metin">Adımları sürükleyip bırakarak sıralayın; kod, başlık, açıklama, rol ve geçiş bilgilerini girdikçe JSON çıktısı ve Mermaid diyagramları otomatik güncellenir.</p>
            <details class="akisma-ornek">
                <summary>Örnek karar akışı JSON'unu görüntüle</summary>
                <pre class="kod-blok">@Html.Raw(algorithmExampleJson)</pre>
            </details>
            @if (algoritmaKilitli)
            {
                <p class="bilgi-kutu uyari">Algoritma düzenleme yetkisi başkan onayı sonrası aktif olur.</p>
            }
            <button type="submit" @(algoritmaKilitli ? "disabled" : null)>Algoritmayı Kaydet</button>
        </form>
    </section>
}

@if (Model.Proje is not null && User.IsInRole(RoleConstants.Roles.Yazilimci))
{
    <section class="form-alani">
        <h2>Teknik Kılavuz Güncelle</h2>
        <form asp-action="KilavuzGuncelle" asp-route-id="@Model.Talep!.Id" method="post" enctype="multipart/form-data">
            <label for="teknikKilavuz">Teknik Kılavuz (PDF)</label>
            <input type="file" id="teknikKilavuz" name="teknikKilavuzDosyasi" accept=".pdf" />
            <p class="yardim-metin">Yalnızca geliştiriciler teknik kılavuz yükleyebilir. En fazla 20 MB boyutunda PDF yükleyin.</p>
            @if (!string.IsNullOrWhiteSpace(Model.Proje.TechnicalGuidePath))
            {
                <p class="dosya-link"><a href="@Model.Proje.TechnicalGuidePath" target="_blank" rel="noopener">Mevcut teknik kılavuzu indir</a></p>
            }
            <button type="submit">Teknik Kılavuzu Güncelle</button>
        </form>
        @if (Model.Talep?.Status == RequestStatus.Gelistirmede)
        {
            <form asp-action="GelistirmeTamamla" asp-route-id="@Model.Talep!.Id" method="post" class="tek-satir-form">
                <button type="submit" class="buton-link">Geliştirmeyi Tamamlandı Olarak İşaretle</button>
            </form>
        }
    </section>
}

@if (Model.Proje is not null && User.IsInRole(RoleConstants.Roles.BirimKullanicisi))
{
    <section class="form-alani">
        <h2>Kullanım Kılavuzu Güncelle</h2>
        <form asp-action="KilavuzGuncelle" asp-route-id="@Model.Talep!.Id" method="post" enctype="multipart/form-data">
            <label for="kullanimKilavuzu">Kullanım Kılavuzu (PDF)</label>
            <input type="file" id="kullanimKilavuzu" name="kullanimKilavuzuDosyasi" accept=".pdf" />
            <p class="yardim-metin">Kullanım kılavuzları yalnızca talep sahibi birim tarafından yüklenebilir.</p>
            @if (!string.IsNullOrWhiteSpace(Model.Proje.UserGuidePath))
            {
                <p class="dosya-link"><a href="@Model.Proje.UserGuidePath" target="_blank" rel="noopener">Mevcut kullanım kılavuzunu indir</a></p>
            }
            <button type="submit">Kullanım Kılavuzunu Güncelle</button>
        </form>
    </section>
}

@if (User.IsInRole(RoleConstants.Roles.BirimYetkilisi) && Model.Talep?.Status == RequestStatus.OnayBekleniyor)
{
    <section class="form-alani">
        <h2>Onay İşlemleri</h2>
        <form asp-action="Onayla" method="post">
            <input type="hidden" name="id" value="@Model.Talep!.Id" />
            <label for="aciklama">Not</label>
            <textarea name="aciklama" rows="3"></textarea>
            <button type="submit">Onayla</button>
        </form>
        <form asp-action="Reddet" method="post">
            <input type="hidden" name="id" value="@Model.Talep!.Id" />
            <label for="aciklama">Red Nedeni</label>
            <textarea name="aciklama" rows="3"></textarea>
            <button type="submit" class="ikincil">Reddet</button>
        </form>
    </section>
}

@if ((User.IsInRole(RoleConstants.Roles.DegerlendiriciBir) ||
      User.IsInRole(RoleConstants.Roles.DegerlendiriciIki) ||
      User.IsInRole(RoleConstants.Roles.DegerlendiriciUc) ||
      User.IsInRole(RoleConstants.Roles.Admin)) && Model.Talep?.Status == RequestStatus.Degerlendirmede)
{
    <section class="form-alani">
        <a class="buton-link" asp-action="Degerlendir" asp-route-id="@Model.Talep!.Id">Teknik Değerlendirme Yap</a>
    </section>
}

@if (User.IsInRole(RoleConstants.Roles.DegerlendirmeBaskani) && Model.Talep?.Status == RequestStatus.BaskanOnayiBekliyor)
{
    <section class="form-alani">
        <a class="buton-link" asp-action="Degerlendir" asp-route-id="@Model.Talep!.Id">Başkan Kararı Ver</a>
    </section>
}

@if (Model.Talep?.Status == RequestStatus.Tamamlandi &&
    (User.IsInRole(RoleConstants.Roles.BirimKullanicisi) || User.IsInRole(RoleConstants.Roles.BirimYetkilisi) || User.IsInRole(RoleConstants.Roles.Admin)))
{
    <section class="form-alani">
        <h2>Birim Test Onayı</h2>
        <form asp-action="TestiOnayla" asp-route-id="@Model.Talep!.Id" method="post">
            <p>Geliştirilen yazılımı test ettiğinizi onaylayın.</p>
            <button type="submit">Test Onayı Ver</button>
        </form>
    </section>
}

@if (Model.Proje is not null)
{
    <section class="form-alani">
        <h2>Geliştirici &amp; Birim Sohbeti</h2>
        @if (Model.Mesajlar.Any())
        {
            <ul class="sohbet-listesi">
                @foreach (var mesaj in Model.Mesajlar)
                {
                    <li>
                        <div class="sohbet-baslik">
                            <strong>@mesaj.Sender?.FullName</strong>
                            <span>@mesaj.PostedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <p>@mesaj.Message</p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Henüz mesaj bulunmuyor.</p>
        }

        @if (User.IsInRole(RoleConstants.Roles.Yazilimci) ||
            User.IsInRole(RoleConstants.Roles.BirimKullanicisi) ||
            User.IsInRole(RoleConstants.Roles.BirimYetkilisi) ||
            User.IsInRole(RoleConstants.Roles.Admin))
        {
            <form asp-action="MesajGonder" asp-route-id="@Model.Talep!.Id" method="post">
                <label for="mesaj">Mesaj</label>
                <textarea id="mesaj" name="mesaj" rows="3"></textarea>
                <button type="submit">Gönder</button>
            </form>
        }
    </section>
}
