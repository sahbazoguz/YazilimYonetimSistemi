@model UludagSoftwareTracking.Controllers.AccountController.LoginViewModel
@{
    ViewData["Title"] = "Sisteme Giriş";
}

<section class="form-kapsayici">
    <h1 class="sayfa-baslik">Sisteme Giriş</h1>
    <p class="aciklama">Kurumsal kullanıcı adınız ve şifreniz ile giriş yapabilir ya da etki alanı hesabınızla doğrulanabilirsiniz.</p>

    <form asp-action="Giris" method="post" class="form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grup">
            <label asp-for="KullaniciAdi" class="form-label"></label>
            <input asp-for="KullaniciAdi" class="form-control" autocomplete="username" />
            <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
        </div>

        <div class="form-grup">
            <label asp-for="Sifre" class="form-label"></label>
            <input asp-for="Sifre" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Sifre" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="BeniHatirla" class="form-check-input" />
            <label asp-for="BeniHatirla" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">Giriş Yap</button>
    </form>

    <div class="test-hesaplari">
        <h2>Test Hesapları</h2>
        <p>Yerel geliştirme sırasında aşağıdaki kullanıcı adları ile giriş yapabilirsiniz. Tüm test hesaplarının şifresi <strong>Parola123!</strong> değeridir. Kullanıcı adını doğrudan yazabilir veya <code>ULUDAG\\</code> etki alanı öneki ile kullanabilirsiniz.</p>
        <ul>
            <li><strong>admin</strong> &mdash; Sistem Yöneticisi (Admin)</li>
            <li><strong>birimyetkilisi</strong> &mdash; Birim Yetkilisi</li>
            <li><strong>birimkullanici</strong> &mdash; Birim Kullanıcısı</li>
            <li><strong>itdegerlendirme</strong> &mdash; Bilgi İşlem Değerlendirme Ekibi</li>
            <li><strong>yazilimlider</strong> &mdash; Yazılım Ekibi Lideri</li>
            <li><strong>yazilimci1</strong> &mdash; Yazılımcı</li>
            <li><strong>ogrenci</strong> &mdash; Öğrenci</li>
            <li><strong>personel</strong> &mdash; Personel</li>
        </ul>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
